{
    "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
    "name": "commonlibsse-sample-plugin",
    "description": "NG Implementation of Devious Devices - SKSE plugin.",
    "homepage": "https://github.com/IHateMyKite/DeviousDevicesNG",
    "license": "Apache-2.0",
    "features": {
        "plugin": {
            "description": "Build the SKSE plugin.",
            "dependencies": [
                "detours",
                "directxmath",
                "directxtk",
                "rapidcsv",
                "spdlog",
                "xbyak",
                "boost-algorithm",
                "boost-math",
                "boost-lexical-cast",
                "boost-property-tree"
            ]
        },
        "tests": {
            "description": "Build tests for the SKSE plugin.",
            "dependencies": [
                {
                    "name": "commonlibsse-sample-plugin",
                    "default-features": false,
                    "features": [
                        "plugin"
                    ]
                },
                "catch2"
            ]
        }
    },
    "builtin-baseline": "ee12231b20c95013c6638d845d04c91559a1d1ff",
    "default-features": [
        "plugin",
        "tests"
    ]
}
